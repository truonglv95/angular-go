{
  "name": "new-demo-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "vite": "vite",
    "vite:dev": "vite --config vite.config.ts --host 127.0.0.1",
    "vite:build": "vite build --config vite.config.ts",
    "vite:preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "e2e:prepare": "cd ../.. && go build -o go-ngc ./angular-packages/compiler_cli/cmd/ngtsc/main.go && cd angular-packages/angular-go && npm run build",
    "test:e2e": "npm run test:e2e:vite:dev",
    "test:e2e:prod": "npm run test:e2e:vite:prod",
    "test:e2e:vite:dev": "playwright test --config playwright.config.ts",
    "test:e2e:vite:prod": "playwright test --config playwright.prod.config.ts",
    "test:builder:dev": "npm run e2e:prepare && npm run test:e2e:vite:dev",
    "test:builder:prod": "npm run e2e:prepare && npm run test:e2e:vite:prod"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/animations": "^21.2.15",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
    "angular-go": "^1.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.10.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
