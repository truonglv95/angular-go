{
  "name": "angular-go-testbed",
  "version": "1.0.0",
  "description": "Fast Angular component testing system powered by Vitest and go-ngc",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vitest": {
      "import": "./dist/vitest/index.js",
      "types": "./dist/vitest/index.d.ts"
    },
    "./setup": {
      "import": "./dist/vitest/setup.js",
      "types": "./dist/vitest/setup.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "vite-plugin-angular-go": "file:../vite-plugin-angular-go"
  },
  "devDependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@types/node": "^25.9.1",
    "happy-dom": "^20.10.2",
    "jsdom": "^28.0.0",
    "rxjs": "^7.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
